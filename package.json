    "fake-indexeddb": "^6.2.6",
    "fflate": "^0.8.3",
    "globals": "^15.9.0",
    "jsdom": "^25.0.1",
    "msw": "^2.15.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.11",
    "typescript": "^5.5.3",
    "vite": "^5.4.5",
