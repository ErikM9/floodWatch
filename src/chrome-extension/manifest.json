{
  "manifest_version": 3,
  "name": "FloodWatch",
  "version": "1.0.0",
  "action": {
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "description": "This is the description of your extension",
  "icons": {
    "32": "public/32.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "public/logo.png"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}