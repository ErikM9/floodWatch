{
  "manifest_version": 3,
  "name": "FloodWatch",
  "version": "1.0.0",
  "description": "This extension alerts UK based users about floods based on their location.",
  "icons": {
    "32": "public/32.png"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "web_accessible_resources": [
    {
      "resources": [
        "public/logo.svg",
        "public/16.png",
        "public/32.png",
        "public/48.png",
        "public/128.png",
        "public/192.png"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "permissions": ["storage", "notifications", "alarms"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "host_permissions": ["https://environment.data.gov.uk/*"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}
