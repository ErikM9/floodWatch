{
  "manifest_version": 3,
  "name": "FloodWatch",
  "version": "1.0.0",
  "description": "This extension alerts users in England about floods based on their location.",
  "icons": {
    "16": "public/16.png",
    "32": "public/32.png",
    "48": "public/48.png",
    "128": "public/128.png"
  },
  "action": {
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "permissions": ["storage", "notifications", "alarms"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "host_permissions": ["https://environment.data.gov.uk/*"]
}